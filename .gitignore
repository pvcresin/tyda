/target
/subject/*
!/subject/.gitkeep
# sample is a repo-authored fixture; the other subjects are fetched by scripts/setup_subjects.sh
!/subject/sample
# Local agent state stays ignored, but the skills symlink (-> .agent/skills) is shared
/.claude/*
!/.claude/skills
/.serena/
# RBS is generated from the rbs gem (scripts/vendor-rbs.sh). Gemfile.lock is authoritative.
/vendor/rbs
/vendor/bundle
# Playground wasm build artifacts (regenerated by scripts/build-wasm.sh + bundle-rbs.mjs)
/playground/public/tyda.wasm
/playground/public/rbs-bundle.json
# Vite build output (published to GitHub Pages by CI)
/playground/dist
# Playground / E2E tooling
/node_modules
/test-results
/playwright-report
# RubyGems packaging artifacts (gem build output + precompiled binary staged by release CI)
/*.gem
/pkg
/libexec
