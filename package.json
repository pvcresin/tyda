{
  "name": "tyda-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tyda Playground — wasm browser demo (CodeLens + diagnostics + hover) and its E2E.",
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsc --noEmit -p playground/tsconfig.json && vite build --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.1",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "oxfmt": "^0.55.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
