{
  "name": "tyda-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tyda Playground — wasm browser demo (CodeLens + diagnostics + hover) and its E2E.",
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit -p playground/tsconfig.json",
    "lint": "oxlint --deny-warnings playground",
    "format": "oxfmt --write playground",
    "format:check": "oxfmt --check playground",
    "check:playground": "npm run typecheck && npm run lint && npm run format:check",
    "build": "npm run typecheck && vite build --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.1",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
